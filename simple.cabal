library nnets
    exposed-modules: NNets
    other-modules:  NNets.Common, 
                    NNets.Common.Algebras,
                    NNets.Common.BackProp,
                    NNets.Common.Coproduct,
                    NNets.Common.Free,
                    NNets.Common.Numeric,
                    NNets.Common.Numeric.Types,
                    NNets.Common.Numeric.Vectors,
                    NNets.Common.Numeric.Activations,
                    NNets.Layers,
                    NNets.Layers.DenseLayer,
                    NNets.Layers.InputLayer,
                    NNets.Training.Propagations,
                    NNets.Train,
                    NNets.Debug.PrintNets
    build-depends: base >=4.12.0.0, array, random
    hs-source-dirs: src
    default-language: GHC2021
    -- default-extensions: Strict 

benchmark ann-warray-bench
    type: exitcode-stdio-1.0
    build-depends:
        base,
        tasty,
        tasty-bench,
        deepseq,
        nnets,
        random,
        array
    hs-source-dirs: benchmark
    default-language: GHC2021
    main-is: fastListExamples.hs
    ghc-options:    -rtsopts
    default-extensions: Strict

